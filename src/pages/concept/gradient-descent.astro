---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TabNav from '../../components/TabNav.astro';
import { loadGlobal, loadPage } from '../../lib/content';

const global = loadGlobal();
const { meta, content } = loadPage('gradient-descent');
const c = content as {
  heading: string;
  eyebrow: string;
  subtitle: string;
};

const jsonLD = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: c.heading,
  description: meta.description,
  url: global.url + '/concept/gradient-descent',
};
---

<BaseLayout
  title={meta.title ?? undefined}
  description={meta.description}
  ogImage={meta.og_image}
  jsonLD={jsonLD}
>

  <section class="viz-wrap">
    <div class="viz-container" x-data="gradientDescent">

      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.heading}</h1>
      <p class="subtitle">{c.subtitle}</p>

      <div class="card">
        <div class="card-header" x-on:change="reset()">
          <p class="card-label"><span class="label-upper">Loss function</span> L(θ)</p>
          <TabNav
            modelField="surface"
            options={[
              { value: 'convex', label: 'Convex' },
              { value: 'nonconvex', label: 'Non-convex' },
              { value: 'multimodal', label: 'Multimodal' },
            ]}
          />
        </div>
        <div class="action-row">
          <div class="action-buttons">
            <button class="button-viz" x-on:click="step()" x-bind:disabled="!hasStart || diverged">Step <span class="step-icon">&#9654;</span></button>
            <button class="button-viz" x-on:click="reset()">Reset</button>
          </div>
        </div>
        <canvas id="gd-curve" class="curve-canvas"></canvas>
        <div class="bottom-row">
          <div class="bottom-left">
            <div class="slider-row lr-slider">
              <span class="slider-val" x-text="'γ = ' + parseFloat(learningRate).toFixed(3)"></span>
              <input type="range" min="0.001" max="1.0" step="0.001"
              x-model="learningRate" />
            </div>
            <p class="click-hint">Click a point on the plot to reposition starting point</p>
            <div class="step-info">
              <span class="step-label" x-text="'step ' + stepCount"></span>
              <span class="theta-val" x-show="thetaDisplay" x-text="'θ = ' + thetaDisplay"></span>
              <span class="loss-val" x-show="lossDisplay" x-text="'L = ' + lossDisplay"></span>
            </div>
          </div>
          <div class="minimap">
            <p class="minimap-label">L per step</p>
            <canvas id="gd-loss"></canvas>
          </div>
          <div class="mobile-stats">
            <span class="step-label" x-text="'step ' + stepCount"></span>
            <span class="theta-val" x-show="thetaDisplay" x-text="'θ = ' + thetaDisplay"></span>
            <span class="loss-val" x-show="lossDisplay" x-text="'L = ' + lossDisplay"></span>
          </div>
        </div>
      </div>

      <div class="insight">
        <p class="card-label">Key ideas</p>
        <ul>
          <li><strong>Gradient descent update:</strong> {"$\\hat{\\theta} = \\theta - \\gamma \\cdot \\nabla_\\theta L(x,y:\\theta)$"}. Each step moves θ opposite to the gradient of the loss function</li>
          <li><strong>Learning rate γ controls step size.</strong> Too high and the optimizer overshoots and diverges. Too low and convergence is slow</li>
          <li><strong>Convex loss functions</strong> have a single global minimum. Gradient descent always converges with a small enough γ</li>
          <li><strong>Non-convex loss functions</strong> can trap the optimizer in local minima. The final result depends on the starting point</li>
          <li><strong>The chain rule</strong> enables computing gradients through composed functions: {"$\\frac{\\partial L}{\\partial \\theta_k} = \\frac{\\partial L}{\\partial z} \\cdot \\frac{\\partial z}{\\partial \\theta_k}$"}</li>
        </ul>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .label-upper {
    text-transform: uppercase;
  }

  .card-header {
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .action-row {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .card-label {
    margin-bottom: 0.5rem;
  }

  .curve-canvas {
    display: block;
    width: 100%;
    height: 20rem;
    cursor: crosshair;
    margin-bottom: 0.5rem;
  }

  .bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .bottom-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .minimap {
    width: 12rem;
    flex-shrink: 0;
    border: 0.0625rem solid var(--bronze);
    border-radius: 0.375rem;
    padding: 0.375rem 0.5rem;
  }

  .minimap-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--potters-clay);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.125rem;
  }

  .click-hint {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--potters-clay);
  }

  .step-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .step-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--teak);
  }

  .theta-val {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--teak);
  }

  .loss-val {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--porsche);
  }

  .lr-slider {
    margin-top: 0;
    max-width: 16rem;
  }

  .lr-slider .slider-val {
    min-width: 6.5rem;
    font-weight: normal;
  }

  .mobile-stats {
    display: none;
  }

  .action-buttons {
    display: flex;
    gap: 0.75rem;
  }

  .step-icon {
    font-size: 0.75em;
    position: relative;
    top: -0.05rem;
    margin-left: 0.25rem;
  }

  @media (max-width: 30em) {
    .curve-canvas {
      height: 14rem;
    }

    .bottom-row {
      display: grid;
      grid-template-columns: 8rem 1fr;
      grid-template-rows: auto auto;
      align-items: start;
      gap: 0.5rem 0.75rem;
    }

    .bottom-left {
      grid-column: 1 / -1;
      gap: 0.375rem;
    }

    .bottom-left .step-info {
      display: none;
    }

    .minimap {
      grid-column: 1;
      width: auto;
    }

    .mobile-stats {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 0.25rem;
    }

    .lr-slider {
      max-width: none;
    }

    .card-header {
      justify-content: flex-end;
    }

    .card-label {
      width: 100%;
    }
  }
</style>
