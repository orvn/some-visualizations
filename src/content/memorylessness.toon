meta:
  title: "Memorylessness"
  description: The exponential distribution forgets the past. Select any wait time and see that the remaining distribution is always identical.
  og_image: /og-image.png

options: null

content:
  heading: "Memorylessness"
  eyebrow: "Exponential Distribution"
  subtitle: "$\\mathbb{P}(X > s + t \\mid X > s) = \\mathbb{P}(X > t)$ — the past tells you nothing about the future"
